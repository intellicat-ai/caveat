    a caveat:OpenAlexTopic, skos:Concept ;
    skos:inScheme caveatoa:scheme ;
    skos:prefLabel "Bone health and treatments"@en ;
    rdfs:label "Bone health and treatments"@en ;
    skos:notation "T11221" ;
    caveat:openAlexId "T11221" ;
    skos:exactMatch <https://openalex.org/T11221> ;
    skos:scopeNote "This cluster of papers focuses on the use of bisphosphonates in the treatment of bone metastases and associated complications, particularly osteonecrosis of the jaw. It explores the mechanisms of action, clinical features, and therapeutic opportunities for bisphosphonates in cancer treatment, with a specific emphasis on prostate and breast cancer. The papers also discuss the role of bisphosphonates in maintaining bone health and preventing skeletal complications in cancer patients."@en ;
    caveat:openAlexKeyword "Bisphosphonates"@en, "Bone Metastasis"@en, "Breast Cancer"@en, "Cancer Treatment"@en, "Clinical Practice Guidelines"@en, "Mechanism of Action"@en, "Metastatic Bone Disease"@en, "Osteonecrosis of the Jaw"@en, "Prostate Cancer"@en, "Skeletal Complications"@en ;
