    skos:inScheme caveatoa:scheme ;
    skos:prefLabel "Pregnancy and Medication Impact"@en ;
    rdfs:label "Pregnancy and Medication Impact"@en ;
    skos:notation "T11964" ;
    caveat:openAlexId "T11964" ;
    skos:exactMatch <https://openalex.org/T11964> ;
    skos:scopeNote "This cluster of papers explores the effects of medication, particularly immunosuppressive drugs, on pregnancy outcomes, focusing on conditions such as inflammatory bowel disease, rheumatoid arthritis, and asthma. It covers topics such as medication use during pregnancy, placental transfer of drugs, impact on birth outcomes, fertility, and teratogenicity. Additionally, it delves into the management of nausea and vomiting in pregnancy and the safety of various medications for both mother and fetus."@en ;
    caveat:openAlexKeyword "Asthma Exacerbations"@en, "Birth Outcomes"@en, "Fertility"@en, "Immunosuppressive Drugs"@en, "Inflammatory Bowel Disease"@en, "Medication Use"@en, "Nausea and Vomiting"@en, "Pregnancy"@en, "Rheumatoid Arthritis"@en, "Teratogenicity"@en ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Effect_of_drugs_on_the_fetus_and_neonate> ;
    caveat:parentSubfield caveatoa:subfield_2739 ;
    skos:broader caveatoa:subfield_2739 .

