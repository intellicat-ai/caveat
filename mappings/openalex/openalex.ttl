    caveat:openAlexId "T11149" ;
    skos:exactMatch <https://openalex.org/T11149> ;
    skos:scopeNote "This cluster of papers focuses on the use of pet dogs as models for human cancer research, particularly in the areas of comparative oncology, translational research, and molecular pathology. It includes studies on canine tumor models, genomic analysis, histological grading systems, immunotherapy, and the transmission dynamics of transmissible cancers in animals. The research also explores the potential for translating new cancer treatments and diagnostic methods from pet dogs to humans."@en ;
    caveat:openAlexKeyword "Cancer Treatment"@en, "Canine Cancer"@en, "Comparative Oncology"@en, "Genomic Analysis"@en, "Histological Grading"@en, "Immunotherapy"@en, "Molecular Pathology"@en, "Tasmanian Devil Facial Tumor Disease"@en, "Translational Research"@en, "Tumor Models"@en ;
