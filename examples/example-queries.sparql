# CAVEAT Example SPARQL Queries
# Run these against the example data in this directory to verify
# competency questions are answerable.

# ============================================================
# CQ1: What unreliability modes does a document have?
# ============================================================
PREFIX caveat: <https://w3id.org/intellicat/caveat#>
PREFIX ex: <https://w3id.org/intellicat/caveat/examples/>

SELECT ?mode ?role WHERE {
  {
    ex:trivedi_2016_splenocyte caveat:primaryUnreliabilityMode ?mode .
    BIND("primary" AS ?role)
  } UNION {
    ex:trivedi_2016_splenocyte caveat:secondaryUnreliabilityMode ?mode .
    BIND("secondary" AS ?role)
  }
}

# Expected:
# caveat:BiofieldEnergyHealing  | primary
# caveat:PredatoryJournalPublication | secondary
# caveat:PapermillOperation | secondary


# ============================================================
# CQ2: Default severity of document's primary mode?
# ============================================================
PREFIX caveat: <https://w3id.org/intellicat/caveat#>
PREFIX ex: <https://w3id.org/intellicat/caveat/examples/>

SELECT ?severity WHERE {
  ex:trivedi_2016_splenocyte caveat:primaryUnreliabilityMode ?mode .
  ?mode caveat:defaultSeverity ?severity .
}

# Expected: 1.0


# ============================================================
# CQ5: What markers are evidence for papermill operation?
# ============================================================
PREFIX caveat: <https://w3id.org/intellicat/caveat#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?marker ?strength WHERE {
  ?link a caveat:EvidenceLink ;
        caveat:linkMarker ?marker ;
        caveat:linkMode caveat:PapermillOperation ;
        caveat:evidenceStrength ?s .
  ?s rdfs:label ?strength .
}

# Expected:
# caveat:TorturedPhrases | strong
# caveat:BoilerplateTemplateText | moderate
# caveat:VerbatimOverlap | moderate
# caveat:ClonedImages | strong
# caveat:DuplicatedDataTables | strong
# caveat:AuthorClusterAnomaly | moderate


# ============================================================
# CQ9: Full inherited vocabulary chain for BiofieldEnergyHealing
# ============================================================
PREFIX caveat: <https://w3id.org/intellicat/caveat#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?ancestor ?lexiconFile WHERE {
  caveat:BiofieldEnergyHealing rdfs:subClassOf* ?ancestor .
  ?ancestor caveat:lexiconFile ?lexiconFile .
}

# Expected:
# caveat:BiofieldEnergyHealing | engagement/biofield-energy-healing.yaml
# caveat:VitalistEnergyMedicine | engagement/vitalist-energy-medicine.yaml
# caveat:Pseudoscience | rejection/pseudoscience-base.yaml
