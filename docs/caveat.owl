<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:caveat="https://w3id.org/intellicat/caveat#"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000019">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A specifically dependent continuant that is exhibited if it inheres in an entity or entities at all.</rdfs:comment>
    <rdfs:label xml:lang="en">quality</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000020">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An entity that depends on one or more specific independent continuants for its existence.</rdfs:comment>
    <rdfs:label xml:lang="en">specifically dependent continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An entity that is generically dependent on some artifact and stands in relation of aboutness to some entity.</rdfs:comment>
    <rdfs:label xml:lang="en">information content entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat">
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-08</dcterms:created>
    <dcterms:description xml:lang="en">An OWL 2 ontology for classifying unreliable scientific literature and the markers used to detect it.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</dcterms:modified>
    <dcterms:title xml:lang="en">CAVEAT: Controlled Annotation Vocabulary for Epistemic Aberration Types</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:seeAlso rdf:resource="https://github.com/intellicat-ai/caveat"/>
    <owl:versionInfo>0.2.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#AnnotatedDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">annotated document</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <caveat:definition xml:lang="en">An information content entity representing a scientific publication that has been annotated with one or more CAVEAT unreliability modes, detection markers, and/or scientific domain classifications.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#AnomalousReviewTimeline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">anomalous review timeline</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#MetadataMarker"/>
    <caveat:definition xml:lang="en">A metadata marker characterized by an implausibly short interval between submission and acceptance, suggesting absent or perfunctory peer review.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#CompromisedPeerReview"/>
    <caveat:evidenceStrength>moderate</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#AntiEvidenceMedicine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">anti-evidence medicine</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Pseudoscience"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.95</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A pseudoscience that asserts mechanisms for medical harms that have been specifically investigated and refuted, or that asserts therapeutic mechanisms for interventions demonstrated to be inert. Distinguished from other pseudosciences by the direct contradiction of established medical evidence.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#AntiVaxMechanismClaims">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">anti-vaccination mechanism claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#AntiEvidenceMedicine"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.95</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An anti-evidence medicine pseudoscience that asserts specific biological mechanisms by which vaccines cause harms (such as autism) that have been extensively investigated and refuted.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ArtifactAsSignal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">artifact interpreted as signal</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#SystematicMisinterpretation"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A systematic misinterpretation in which an experimental or measurement artifact is interpreted as a genuine biological, physical, or statistical signal.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#AuthorClusterAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">author cluster anomaly</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#MetadataMarker"/>
    <caveat:definition xml:lang="en">A metadata marker characterized by network analysis revealing suspicious patterns of co-authorship, such as implausible international collaborations or known papermill author pools.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#CitationManipulation"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#PapermillOperation"/>
    <caveat:evidenceStrength>moderate</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#AuthorshipMisconduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">authorship misconduct</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DeliberateMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A deliberate misconduct involving the misrepresentation of who contributed to or is responsible for a scientific work.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#BiofieldEnergyHealing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">biofield energy healing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#VitalistEnergyMedicine"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A vitalist energy medicine pseudoscience that claims a human 'biofield' can be transmitted to alter material properties, biological processes, or health outcomes, including at a distance. Distinguished from other vitalist pseudosciences by the specific invocation of 'biofield' terminology and claims of remote transmission.</caveat:definition>
    <caveat:lexiconFile>engagement/biofield-energy-healing.yaml</caveat:lexiconFile>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#BoilerplateTemplateText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">boilerplate or template text</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#TextualMarker"/>
    <caveat:definition xml:lang="en">A textual marker characterized by extensive verbatim or near-verbatim reuse of text across multiple papers, suggesting template-based production.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#DuplicatePublication"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#PapermillOperation"/>
    <caveat:evidenceStrength>moderate</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#CitationManipulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">citation manipulation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#AuthorshipMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An authorship misconduct in which citations are added, removed, or directed for purposes unrelated to scholarly merit, including coercive citation by editors or reviewers and citation rings among collaborating authors.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#CitationPatternAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">citation pattern anomaly</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#MetadataMarker"/>
    <caveat:definition xml:lang="en">A metadata marker characterized by network analysis revealing suspicious patterns of citations, such as implausible interdisciplinary citations, or inclusion in citation rings.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#CitationManipulation"/>
    <caveat:evidenceStrength>definitive</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ClimateScienceDenial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">climate science denial</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Denialism"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A denialism that rejects the established scientific consensus on anthropogenic climate change.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ClonedImages">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">cloned or duplicated images</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DataFigureMarker"/>
    <caveat:definition xml:lang="en">A data or figure marker characterized by the reuse of the same image (possibly rotated, cropped, or recolored) to represent different experimental conditions or results.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Falsification"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#PapermillOperation"/>
    <caveat:evidenceStrength>strong</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ColdFusionLENR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">cold fusion or LENR</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#PathologicalScience"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A pathological science claiming nuclear fusion reactions at or near room temperature in electrochemical cells or other low-energy systems.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#CompromisedPeerReview">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">compromised or fake peer review</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#PublicationProcessMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A publication process misconduct in which the peer review process is subverted, including fabricated reviewer identities, self-review via manipulated submission systems, or collusion between authors and reviewers.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ConclusionsNotSupported">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">conclusions not supported by data</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Overreach"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.35</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An overreach in which the stated conclusions do not logically follow from the results presented.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ConfoundingAsCausation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">confounding interpreted as causation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#SystematicMisinterpretation"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A systematic misinterpretation in which a correlation driven by a confounding variable is interpreted as a direct causal relationship.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#CorpusFamily">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">corpus family</rdfs:label>
    <caveat:definition xml:lang="en">A collection of annotated documents that share a common origin, production method, or thematic pattern, and are analyzed as a group. Examples: all papers from a specific papermill, all publications by a specific fraudulent author, all papers in a specific pseudoscience domain.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#DataFigureMarker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">data or figure marker</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DetectionMarker"/>
    <caveat:definition xml:lang="en">A detection marker observable in the data, figures, or images of a publication.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#DataMisconduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">data misconduct</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DeliberateMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A deliberate misconduct involving the creation, alteration, or suppression of research data or results.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#DeliberateMisconduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">deliberate misconduct</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#UnreliabilityMode"/>
    <caveat:causation>intentional</caveat:causation>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An unreliability mode in which the author(s) knowingly deviated from accepted standards of scientific conduct. Distinguished from other unreliability modes by the presence of intent.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#Denialism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">denialism</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#PremiseLevelFailure"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A premise-level failure characterized by rejection of established scientific consensus, typically through selective citation, manufactured doubt, conspiracy theories, or impossible demands for evidence. Distinguished from pseudoscience in that denialism denies established positives rather than asserting false positives.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#DesignFailures">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">design failures</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ExecutionLevelFailure"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An execution-level failure in which the experimental or study design is fundamentally flawed, rendering the results uninterpretable regardless of how well the study was otherwise conducted.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#DetectionMarker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">detection marker</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    <caveat:definition xml:lang="en">A quality of a scientific publication that is observable and serves as evidence for one or more unreliability modes. Distinguished from unreliability modes in that a marker is what we can see; a mode is what went wrong.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#DetoxPseudoscience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">detoxification pseudoscience</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#AntiEvidenceMedicine"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.95</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An anti-evidence medicine pseudoscience that claims specific interventions (ionic foot baths, chelation for non-indicated conditions, juice cleanses, etc.) remove unnamed 'toxins' from the body through mechanisms that have no physiological basis.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#DuplicatePublication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">duplicate or redundant publication</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#PublicationProcessMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A publication process misconduct in which substantially the same work is published in multiple venues without appropriate cross-referencing or disclosure, in order to inflate publication counts.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#DuplicatedDataTables">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">duplicated data tables across papers</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DataFigureMarker"/>
    <caveat:definition xml:lang="en">A data or figure marker characterized by data tables that appear in substantially identical form across multiple papers, suggesting data reuse or fabrication.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Fabrication"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#PapermillOperation"/>
    <caveat:evidenceStrength>moderate</caveat:evidenceStrength>
    <caveat:evidenceStrength>strong</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ESPPrecognition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ESP or precognition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Parapsychology"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A parapsychology pseudoscience that claims humans can perceive information without the use of known sensory channels, including perception of future events.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#EvolutionDenial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">evolution denial</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Denialism"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A denialism that rejects the established scientific consensus on biological evolution by natural selection.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ExecutionLevelFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">execution-level failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#UnreliabilityMode"/>
    <caveat:causation>methodological_error</caveat:causation>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An unreliability mode in which the premise may be legitimate and the intent honest, but the methodology is flawed in ways that invalidate the conclusions. Distinguished from interpretive failure in that the problem is in how the research was done, not how the results were interpreted.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ExpressionOfConcern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">expression of concern</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#MetadataMarker"/>
    <caveat:definition xml:lang="en">A metadata marker characterized by a formal editorial expression of concern regarding the integrity or validity of a published paper.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Falsification"/>
    <caveat:evidenceStrength>moderate</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#Fabrication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fabrication</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DataMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A data misconduct in which data or results are invented without any basis in actual experimentation or observation. Distinguished from falsification in that no real data existed to be manipulated.</caveat:definition>
    <caveat:definitionSource>ORI: 42 CFR Part 93</caveat:definitionSource>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#FailedIndependentReplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">published failed replication</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ReproducibilityMarker"/>
    <caveat:definition xml:lang="en">A reproducibility marker characterized by one or more published independent attempts to replicate the study's key findings that did not reproduce the reported results.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Fabrication"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#PathologicalScience"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#StatisticalMalpractice"/>
    <caveat:evidenceStrength>moderate</caveat:evidenceStrength>
    <caveat:evidenceStrength>weak</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#FailedReplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">failed independent replication</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ReproducibilityFailures"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A reproducibility failure in which one or more independent attempts to replicate the study's key findings have failed, suggesting the original results were artifactual.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#Falsification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">falsification</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DataMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A data misconduct in which actual research materials, equipment, processes, or data are manipulated, changed, or omitted such that the reported results do not accurately represent the research. Distinguished from fabrication in that real data or processes existed but were altered.</caveat:definition>
    <caveat:definitionSource>ORI: 42 CFR Part 93</caveat:definitionSource>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#GermTheoryDenial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">germ theory denial</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Denialism"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A denialism that rejects the established scientific consensus that specific microorganisms cause specific diseases.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#GhostAuthorship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ghost authorship</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#AuthorshipMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An authorship misconduct in which a person who made substantial contributions to the work is deliberately excluded from the author list.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#GiftAuthorship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gift or honorary authorship</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#AuthorshipMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An authorship misconduct in which a person is included in the author list despite not having made substantial contributions, typically for reasons of prestige, seniority, or reciprocity.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#HomeopathicPharmacology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">homeopathic pharmacology</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#UltraHighDilution"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An ultra-high dilution pseudoscience that claims homeopathic preparations (produced by serial dilution and succussion) have pharmacological activity attributable to the original substance. Distinguished from clinical homeopathy studies by the assertion of specific pharmacological mechanisms.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#IdeaDataPlagiarism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">idea or data plagiarism</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#AuthorshipMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An authorship misconduct in which ideas, methods, or data from another source are appropriated without credit, even if the text is substantially rewritten.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ImageManipulationArtifacts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">image manipulation artifacts</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DataFigureMarker"/>
    <caveat:definition xml:lang="en">A data or figure marker characterized by visible signs of digital manipulation such as splicing boundaries, inconsistent noise patterns, or clone-stamp artifacts.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Falsification"/>
    <caveat:evidenceStrength>strong</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ImpossibleStatistics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">impossible or implausible statistics</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DataFigureMarker"/>
    <caveat:definition xml:lang="en">A data or figure marker characterized by reported statistics that are mathematically impossible given the study parameters, detectable via GRIM, SPRITE, or similar forensic tests.</caveat:definition>
    <caveat:definitionSource>Brown, N.J.L., &amp; Heathers, J.A.J. (2017). The GRIM test.</caveat:definitionSource>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Fabrication"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Falsification"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#StatisticalMalpractice"/>
    <caveat:evidenceStrength>moderate</caveat:evidenceStrength>
    <caveat:evidenceStrength>weak</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#InadequateBlinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inadequate blinding</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DesignFailures"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.35</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A design failure in which participants, experimenters, or analysts are not adequately blinded to treatment allocation in contexts where blinding is feasible and necessary to prevent bias.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#InappropriateControls">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inappropriate or missing controls</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DesignFailures"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A design failure in which the study lacks appropriate control groups or conditions, making it impossible to attribute observed effects to the intervention.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#InappropriateGeneralization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inappropriate generalization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Overreach"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.25</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An overreach in which results from a specific context are generalized to populations, conditions, or settings not supported by the study design.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#InappropriateStatisticalTests">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inappropriate statistical tests</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#StatisticalMalpractice"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A statistical malpractice in which statistical tests are applied to data that violate their assumptions, producing unreliable p-values and confidence intervals.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#InconsistentTerminology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inconsistent terminology within paper</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#TextualMarker"/>
    <caveat:definition xml:lang="en">A textual marker characterized by the use of different terms for the same concept within a single paper, suggesting assembly from multiple sources or automated rewriting.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#InsufficientMethodDetail">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">insufficient methodological detail</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ReproducibilityFailures"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A reproducibility failure in which the methods section lacks sufficient detail for an independent researcher to reproduce the study.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#InterpretiveFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">interpretive failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#UnreliabilityMode"/>
    <caveat:causation>interpretive_error</caveat:causation>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An unreliability mode in which the experiments are real but the interpretation of results is systematically wrong, typically due to self-deception or cognitive biases rather than deliberate fraud. Distinguished from execution-level failure in that the methodology may be sound but the conclusions drawn from it are not.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#LLMGeneratedText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">LLM-generated text</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#TextualMarker"/>
    <caveat:definition xml:lang="en">A textual marker characterized by features indicative of large language model generation, such as unnaturally fluent text, characteristic hedging patterns and punctuation, hallucinations, or known LLM artifacts.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#MagnetizedWater">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">magnetized water</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Pseudoscience"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A pseudoscience that claims liquid water can be permanently or semi-permanently magnetized.</caveat:definition>
    <caveat:lexiconFile>engagement/magnetized-water.yaml</caveat:lexiconFile>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#MetadataMarker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">metadata marker</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DetectionMarker"/>
    <caveat:definition xml:lang="en">A detection marker observable in the publication metadata, editorial history, or surrounding context rather than the content itself.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#MultipleComparisonsUncorrected">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">multiple comparisons without correction</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#StatisticalMalpractice"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A statistical malpractice in which multiple statistical tests are performed without appropriate correction for the inflated false positive rate.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#NRays">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">N-rays</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#PathologicalScience"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A pathological science involving the claimed detection of a novel form of radiation (N-rays) by Prosper-René Blondlot in 1903, subsequently shown to be an artifact of observer expectation.</caveat:definition>
    <caveat:definitionSource>Wood, R.W. (1904). Nature 70:530-531.</caveat:definitionSource>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#NonResponsiveAuthors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">non-responsive authors</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ReproducibilityMarker"/>
    <caveat:definition xml:lang="en">A reproducibility marker characterized by authors who do not respond to reasonable requests for raw data, analysis code, or methodological clarification.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Fabrication"/>
    <caveat:evidenceStrength>weak</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#NonShareableDataCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">non-shareable data or code</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ReproducibilityFailures"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A reproducibility failure in which the raw data, analysis code, or both are unavailable for verification, despite no legitimate reason for restriction.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#OpenAlexDomain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">OpenAlex domain</rdfs:label>
    <caveat:definition xml:lang="en">The highest level of the OpenAlex topic hierarchy. Approximately 4 domains exist (e.g., Life Sciences, Physical Sciences, Social Sciences, Health Sciences).</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#OpenAlexField">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">OpenAlex field</rdfs:label>
    <caveat:definition xml:lang="en">The second level of the OpenAlex topic hierarchy, a child of a domain. Approximately 25 fields exist (e.g., Medicine, Physics, Chemistry).</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#OpenAlexSubfield">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">OpenAlex subfield</rdfs:label>
    <caveat:definition xml:lang="en">The third level of the OpenAlex topic hierarchy, a child of a field. Approximately 250 subfields exist (e.g., Immunology, Nuclear Physics).</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#OpenAlexTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">OpenAlex topic</rdfs:label>
    <caveat:definition xml:lang="en">The most granular level of the OpenAlex topic hierarchy. Approximately 4500 topics exist. This is the level at which CAVEAT anchors its scientific domain classification.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#OrgoneEnergy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">orgone energy</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#VitalistEnergyMedicine"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A vitalist energy medicine pseudoscience based on Wilhelm Reich's claim of a universal 'orgone energy' that can be accumulated and directed for biological effects. Distinguished from other vitalist pseudosciences by the specific theoretical framework derived from Reich.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#Overreach">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">overreach</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ExecutionLevelFailure"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An execution-level failure in which the conclusions stated in the paper are not supported by the evidence presented, going beyond what the data and methods justify.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#PHackingHARKing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">p-hacking or HARKing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#StatisticalMalpractice"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A statistical malpractice in which multiple analyses are conducted and only significant results are reported (p-hacking), or hypotheses are formulated after examining results and presented as if they were a priori (Hypothesizing After Results are Known).</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#PapermillOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">papermill operation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#SystematicFraudulentProduction"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A systematic fraudulent production in which a commercial entity produces fabricated scientific papers for sale, typically using template-based generation, fabricated data, and tortured phrases to evade detection.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#Parapsychology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">parapsychology</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Pseudoscience"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A pseudoscience that claims humans possess abilities to perceive or influence the physical world through mechanisms not accounted for by established physics or neuroscience. Distinguished from other pseudosciences by the invocation of mental or psychic causation.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#PathologicalScience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pathological science</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#InterpretiveFailure"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An interpretive failure meeting Langmuir's criteria: maximum effect from barely detectable cause; effect magnitude near limit of detectability; claims of great accuracy; fantastic theories contrary to experience; criticisms met by ad hoc excuses; ratio of supporters to critics approaches zero over time.</caveat:definition>
    <caveat:definitionSource>Langmuir, I. (1953/1989). Pathological Science.</caveat:definitionSource>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#PostPublicationCritique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">post-publication critique</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#MetadataMarker"/>
    <caveat:definition xml:lang="en">A metadata marker characterized by substantive published criticism of the paper's methods, data, or conclusions on platforms such as PubPeer, journal correspondence, or formal commentary.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#PredatoryJournalIndexing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">predatory journal source</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#MetadataMarker"/>
    <caveat:definition xml:lang="en">A metadata marker characterized by the publication venue appearing on established predatory journal lists similar to Beall's list or Cabell's Predatory Reports.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#PredatoryJournalPublication"/>
    <caveat:evidenceStrength>strong</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#PredatoryJournalPublication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">predatory journal publication</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#PublicationProcessMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A publication process misconduct in which a work is published in a venue that charges fees without providing meaningful editorial or peer review services. Distinguished from legitimate open access by the absence of genuine quality control.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#PremiseLevelFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">premise-level failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#UnreliabilityMode"/>
    <caveat:causation>premise_failure</caveat:causation>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.95</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An unreliability mode in which the foundational hypothesis or theoretical framework of the work has no basis in established science. The work may be internally consistent but starts from a premise that is demonstrably false or unfalsifiable. Distinguished from interpretive failure in that the premise itself, not just the interpretation, is wrong.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#Pseudoscience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pseudoscience</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#PremiseLevelFailure"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.95</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A premise-level failure in which the central claims invoke mechanisms or entities that have been specifically investigated and found baseless. Distinguished from pathological science by the existence of positive evidence of absence, not merely absence of evidence. Distinguished from denialism in that pseudoscience asserts false positives rather than denying established positives.</caveat:definition>
    <caveat:lexiconFile>rejection/pseudoscience-base.yaml</caveat:lexiconFile>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#Psychokinesis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">psychokinesis</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Parapsychology"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A parapsychology pseudoscience that claims humans can influence physical objects or processes through mental intention alone.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#PublicationProcessMisconduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">publication process misconduct</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DeliberateMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A deliberate misconduct involving corruption of the publication or peer review process.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ReikiMechanismStudies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Reiki mechanism studies</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#VitalistEnergyMedicine"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A vitalist energy medicine pseudoscience that claims to identify physical or biological mechanisms for Reiki healing effects. Distinguished from clinical Reiki studies (which may be methodologically flawed but at least measure outcomes) by the assertion of specific causal mechanisms for the purported energy transfer.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#RemoteViewing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">remote viewing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Parapsychology"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A parapsychology pseudoscience that claims humans can perceive detailed information about distant or hidden targets through mental means alone.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ReproducibilityFailures">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reproducibility failures</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ExecutionLevelFailure"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.25</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An execution-level failure in which the work cannot be independently reproduced or verified due to insufficient documentation, unavailable data, or non-replicable results.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ReproducibilityMarker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reproducibility marker</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DetectionMarker"/>
    <caveat:definition xml:lang="en">A detection marker relating to the reproducibility or verifiability of a publication's claims.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#RetractionNotice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">retraction notice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#MetadataMarker"/>
    <caveat:definition xml:lang="en">A metadata marker characterized by a formal retraction notice issued by the journal, indicating the paper has been withdrawn from the published record.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Fabrication"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Falsification"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#TextPlagiarism"/>
    <caveat:evidenceStrength>definitive</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#RetractionRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Structured record of a paper's retraction status, including date, reason, severity, and any associated consequences.</rdfs:comment>
    <rdfs:label xml:lang="en">retraction record</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#RetractionResistantNetwork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">retraction-resistant network</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#SystematicFraudulentProduction"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A systematic fraudulent production in which a coordinated group of authors, editors, or institutions acts to maintain fraudulent literature in the published record by resisting retraction requests, manipulating editorial processes, or republishing retracted work.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#ReverseCausationClaims">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reverse causation claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#SystematicMisinterpretation"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A systematic misinterpretation in which the direction of causation between two correlated variables is asserted incorrectly.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#SelectionBias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">selection bias in sampling</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DesignFailures"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.35</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A design failure in which the sampling method systematically excludes or overrepresents certain subpopulations, producing results that do not generalize to the intended target population.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#SelectiveReporting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">selective reporting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DataMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A data misconduct in which inconvenient or contradictory data are deliberately suppressed or omitted from the reported results, while data supporting the desired conclusion are retained.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#StatisticalClinicalConflation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">conflation of statistical and clinical significance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Overreach"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.25</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An overreach in which a statistically significant result is presented as clinically, practically, or scientifically meaningful without consideration of effect size or practical relevance.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#StatisticalMalpractice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">statistical malpractice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ExecutionLevelFailure"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.35</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An execution-level failure in which statistical methods are applied incorrectly or inappropriately, leading to invalid inferences from the data.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#SuspiciousDataRegularity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">suspicious data regularity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DataFigureMarker"/>
    <caveat:definition xml:lang="en">A data or figure marker characterized by data that are implausibly regular, lacking the noise and variability expected from genuine measurements.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Fabrication"/>
    <caveat:evidenceStrength>moderate</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#SyntheticSpectra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">hand-drawn or synthetic spectra</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DataFigureMarker"/>
    <caveat:definition xml:lang="en">A data or figure marker characterized by spectral data (NMR, IR, mass spectrometry, etc.) that appear to be hand-drawn or computationally generated rather than obtained from actual instruments.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Fabrication"/>
    <caveat:evidenceStrength>strong</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#SystematicFraudulentProduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">systematic fraudulent production</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DeliberateMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A deliberate misconduct characterized by organized, repeated production of fraudulent scientific literature, typically for commercial gain. Distinguished from isolated misconduct by its industrial scale and systematic nature.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#SystematicMisinterpretation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">systematic misinterpretation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#InterpretiveFailure"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An interpretive failure in which valid data are consistently interpreted through an incorrect causal framework, leading to wrong conclusions despite sound methodology.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#TextPlagiarism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">text plagiarism</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#AuthorshipMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An authorship misconduct in which text from another source is reproduced without appropriate attribution. Distinguished from idea plagiarism by the verbatim or near-verbatim nature of the copying.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#TextualMarker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">textual marker</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DetectionMarker"/>
    <caveat:definition xml:lang="en">A detection marker observable in the text of a publication.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#TherapeuticTouchMechanism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">therapeutic touch mechanism claims</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#VitalistEnergyMedicine"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A vitalist energy medicine pseudoscience that claims to identify mechanisms by which a practitioner's hands, held near but not touching a patient, alter physiological processes. Distinguished from other vitalist pseudosciences by the specific claim of non-contact manual manipulation of a 'human energy field'.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#TorturedPhrases">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tortured phrases</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#TextualMarker"/>
    <caveat:definition xml:lang="en">A textual marker characterized by systematic synonym substitution that produces nonsensical phrases, such as 'bosom movement' for 'breast cancer'. Near-pathognomonic for papermill products.</caveat:definition>
    <caveat:definitionSource>Cabanac, G., Labbé, C., &amp; Magazinov, A. (2021). Tortured phrases: A dubious writing style emerging in science. Evidence of critical issues affecting established journals. arXiv:2107.06751.</caveat:definitionSource>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#PapermillOperation"/>
    <caveat:evidenceStrength>strong</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#UltraHighDilution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ultra-high dilution or memory of water</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Pseudoscience"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A pseudoscience that claims substances retain biological or chemical activity at dilutions beyond Avogadro's limit, where no molecules of the original substance remain. Distinguished from other pseudosciences by the specific claim that water or other solvents retain a 'memory' of dissolved substances.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#UnderpoweredStudy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">underpowered study claiming significance</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#StatisticalMalpractice"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A statistical malpractice in which a study with insufficient sample size to detect the claimed effect reports statistically significant results, suggesting either a false positive or inflated effect size.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#UndisclosedConflictOfInterest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">undisclosed conflict of interest</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#PublicationProcessMisconduct"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A publication process misconduct in which financial, personal, or institutional relationships that could bias the research are not disclosed as required by the publication venue.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#UnfalsifiableDesign">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">unfalsifiable design</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#DesignFailures"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A design failure in which the study is structured such that no possible outcome could refute the hypothesis, violating the basic requirement of falsifiability.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#UnreliabilityMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">unreliability mode</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    <caveat:definition xml:lang="en">A quality of a scientific publication that renders it unreliable as a contribution to scientific knowledge. Subclasses are organized by cause (deliberate, premise-level, interpretive, execution-level) with graduated default severity.</caveat:definition>
    <caveat:retractionAwareLexiconFile>rejection/retracted-literature-base.yaml</caveat:retractionAwareLexiconFile>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#VerbatimOverlap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">verbatim overlap with other papers</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#TextualMarker"/>
    <caveat:definition xml:lang="en">A textual marker characterized by substantial verbatim text overlap with one or more other publications, detectable by plagiarism detection tools.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#PapermillOperation"/>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#TextPlagiarism"/>
    <caveat:evidenceStrength>moderate</caveat:evidenceStrength>
    <caveat:evidenceStrength>strong</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#VitalistEnergyMedicine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">vitalist or energy medicine</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#Pseudoscience"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">A pseudoscience that claims a non-physical 'energy', 'vital force', or 'biofield' can be directed by practitioners to cause measurable biological or physical effects. Distinguished from other pseudosciences by the invocation of vitalist mechanisms.</caveat:definition>
    <caveat:lexiconFile>engagement/vitalist-energy-medicine.yaml</caveat:lexiconFile>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#WaterMemory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">water memory</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#UltraHighDilution"/>
    <caveat:defaultSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</caveat:defaultSeverity>
    <caveat:definition xml:lang="en">An ultra-high dilution pseudoscience that claims water retains structural or informational properties of substances previously dissolved in it, even after dilution beyond molecular presence. Distinguished from homeopathic pharmacology by being the proposed underlying mechanism rather than an application.</caveat:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#WithdrawnDataMethodology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">withdrawn data or methodology</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/intellicat/caveat#ReproducibilityMarker"/>
    <caveat:definition xml:lang="en">A reproducibility marker characterized by the withdrawal or retraction of underlying data or methodological components after publication.</caveat:definition>
    <caveat:evidenceFor rdf:resource="https://w3id.org/intellicat/caveat#Falsification"/>
    <caveat:evidenceStrength>strong</caveat:evidenceStrength>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#associatedPerson">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Person associated with the misconduct, used for named-person scoring in TRACES.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#RetractionRecord"/>
    <rdfs:label xml:lang="en">associated person</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#causation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Primary cause category: intentional, premise_failure, interpretive_error, methodological_error.</rdfs:comment>
    <rdfs:label xml:lang="en">causation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#claimedDomain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The scientific domain (OpenAlex topic) that this document claims to contribute to.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#AnnotatedDocument"/>
    <rdfs:label xml:lang="en">claimed domain</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#OpenAlexTopic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#corpusFamily">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The corpus family to which this document belongs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#AnnotatedDocument"/>
    <rdfs:label xml:lang="en">member of corpus family</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#CorpusFamily"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#defaultSeverity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Default severity on a 0.0-1.0 scale. 0.0 = negligible impact on paper reliability. 1.0 = paper is entirely unreliable. Consumers may override for their specific context.</rdfs:comment>
    <rdfs:label xml:lang="en">default severity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Aristotelian definition: genus (parent class) + differentia.</rdfs:comment>
    <rdfs:label xml:lang="en">definition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#definitionSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Citable source for the definition.</rdfs:comment>
    <rdfs:label xml:lang="en">definition source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#detectionMarkerObserved">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">A detection marker that has been observed in this document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#AnnotatedDocument"/>
    <rdfs:label xml:lang="en">detection marker observed</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#DetectionMarker"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#estimatedSize">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Approximate number of documents in this corpus family.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#CorpusFamily"/>
    <rdfs:label xml:lang="en">estimated corpus size</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#evidenceFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Asserts that observing this detection marker is evidence for the linked unreliability mode.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#DetectionMarker"/>
    <rdfs:label xml:lang="en">evidence for</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#UnreliabilityMode"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#evidenceStrength">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Strength of the evidential link. Values: 'definitive' (marker alone is sufficient), 'strong' (high positive predictive value), 'moderate' (suggestive, needs corroboration), 'weak' (possible indicator, high false positive rate).</rdfs:comment>
    <rdfs:label xml:lang="en">evidence strength</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#legalConsequences">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Free text describing legal consequences: 'none', 'criminal conviction', 'civil settlement', etc.</rdfs:comment>
    <rdfs:label xml:lang="en">legal consequences</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#lexiconFile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Path to the YAML vocabulary file for this mode, relative to the vocabularies/ directory. Vocabulary inherits top-down: a mode's effective vocabulary includes its own terms plus all ancestor terms.</rdfs:comment>
    <rdfs:label xml:lang="en">lexicon file</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#openAlexId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The OpenAlex identifier for this entity (e.g., 'T12345' for a topic).</rdfs:comment>
    <rdfs:label xml:lang="en">OpenAlex ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#openAlexSnapshotDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">The date on which OpenAlex data was retrieved for this import. Since OpenAlex is actively maintained, topic assignments may change.</rdfs:comment>
    <rdfs:label xml:lang="en">OpenAlex snapshot date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#parentDomain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#OpenAlexField"/>
    <rdfs:label xml:lang="en">parent domain</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#OpenAlexDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#parentField">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#OpenAlexSubfield"/>
    <rdfs:label xml:lang="en">parent field</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#OpenAlexField"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#parentSubfield">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#OpenAlexTopic"/>
    <rdfs:label xml:lang="en">parent subfield</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#OpenAlexSubfield"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#personName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">person name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#primaryUnreliabilityMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The principal unreliability mode for this document. Each document should have exactly one primary mode.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#AnnotatedDocument"/>
    <rdfs:label xml:lang="en">primary unreliability mode</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#UnreliabilityMode"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#retractionAwareLexiconFile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Path to a YAML vocabulary file that is activated only for probes involving retracted source papers, rather than through the normal class inheritance chain.</rdfs:comment>
    <rdfs:label xml:lang="en">retraction-aware lexicon file</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#retractionDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#RetractionRecord"/>
    <rdfs:label xml:lang="en">retraction date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#retractionNoticeDOI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#RetractionRecord"/>
    <rdfs:label xml:lang="en">retraction notice DOI</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#retractionReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#RetractionRecord"/>
    <rdfs:label xml:lang="en">retraction reason</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#retractionSeverity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Classification of the severity of a retraction case,
used in TRACES probe metadata for stratified reporting. Does not affect
IS scoring (see TRACES spec: 'Why Not Severity-Weight the Headline
Number'). Values: catastrophic, major, standard.</rdfs:comment>
    <rdfs:label xml:lang="en">retraction severity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#retractionSeverityValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Severity classification for this retraction record, used for document-level annotation and stratified reporting. Expected values: catastrophic, major, standard.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#RetractionRecord"/>
    <rdfs:label xml:lang="en">retraction severity value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#retractionStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#AnnotatedDocument"/>
    <rdfs:label xml:lang="en">retraction status</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#RetractionRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#secondaryUnreliabilityMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">An additional unreliability mode for this document. A document may have zero or more secondary modes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#AnnotatedDocument"/>
    <rdfs:label xml:lang="en">secondary unreliability mode</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#UnreliabilityMode"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/intellicat/caveat#siblingTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/intellicat/caveat#OpenAlexTopic"/>
    <rdfs:label xml:lang="en">sibling topic</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/intellicat/caveat#OpenAlexTopic"/>
    <caveat:definition xml:lang="en">Two OpenAlex topics that share a parent subfield and are designated as siblings in the OpenAlex topic taxonomy. Useful for identifying related fields where similar unreliability patterns may occur, and for constructing matched controls.</caveat:definition>
  </rdf:Description>
</rdf:RDF>
