@prefix caveat:   <https://w3id.org/intellicat/caveat#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/intellicat/caveat/modules/marker-evidence> a owl:Ontology ;
    rdfs:comment "Links between detection markers and unreliability modes. Each link asserts that observing the marker is evidence for the mode, with a strength qualifier."@en .

# =============================================================================
# EVIDENCE PROPERTIES
# =============================================================================

caveat:evidenceFor a owl:ObjectProperty ;
    rdfs:label "evidence for"@en ;
    rdfs:comment "Asserts that observing this detection marker is evidence for the linked unreliability mode."@en ;
    rdfs:domain caveat:DetectionMarker ;
    rdfs:range caveat:UnreliabilityMode .

caveat:evidenceStrength a owl:AnnotationProperty ;
    rdfs:label "evidence strength"@en ;
    rdfs:comment "Strength of the evidential link. Values: 'definitive' (marker alone is sufficient), 'strong' (high positive predictive value), 'moderate' (suggestive, needs corroboration), 'weak' (possible indicator, high false positive rate)."@en .

# =============================================================================
# TEXTUAL MARKER LINKS
# =============================================================================

caveat:TorturedPhrases
    caveat:evidenceFor caveat:PapermillOperation ;
    caveat:evidenceStrength "strong" .

caveat:BoilerplateTemplateText
    caveat:evidenceFor caveat:PapermillOperation ;
    caveat:evidenceStrength "moderate" .

caveat:BoilerplateTemplateText
    caveat:evidenceFor caveat:DuplicatePublication ;
    caveat:evidenceStrength "moderate" .

caveat:VerbatimOverlap
    caveat:evidenceFor caveat:TextPlagiarism ;
    caveat:evidenceStrength "strong" .

caveat:VerbatimOverlap
    caveat:evidenceFor caveat:PapermillOperation ;
    caveat:evidenceStrength "moderate" .

# =============================================================================
# DATA / FIGURE MARKER LINKS
# =============================================================================

caveat:ClonedImages
    caveat:evidenceFor caveat:Falsification ;
    caveat:evidenceStrength "strong" .

caveat:ClonedImages
    caveat:evidenceFor caveat:PapermillOperation ;
    caveat:evidenceStrength "strong" .

caveat:ImageManipulationArtifacts
    caveat:evidenceFor caveat:Falsification ;
    caveat:evidenceStrength "strong" .

caveat:SyntheticSpectra
    caveat:evidenceFor caveat:Fabrication ;
    caveat:evidenceStrength "strong" .

caveat:ImpossibleStatistics
    caveat:evidenceFor caveat:Fabrication ;
    caveat:evidenceStrength "moderate" .

caveat:ImpossibleStatistics
    caveat:evidenceFor caveat:Falsification ;
    caveat:evidenceStrength "moderate" .

caveat:ImpossibleStatistics
    caveat:evidenceFor caveat:StatisticalMalpractice ;
    caveat:evidenceStrength "weak" .

caveat:SuspiciousDataRegularity
    caveat:evidenceFor caveat:Fabrication ;
    caveat:evidenceStrength "moderate" .

caveat:DuplicatedDataTables
    caveat:evidenceFor caveat:PapermillOperation ;
    caveat:evidenceStrength "strong" .

caveat:DuplicatedDataTables
    caveat:evidenceFor caveat:Fabrication ;
    caveat:evidenceStrength "moderate" .

# =============================================================================
# METADATA MARKER LINKS
# =============================================================================

caveat:PredatoryJournalIndexing
    caveat:evidenceFor caveat:PredatoryJournalPublication ;
    caveat:evidenceStrength "strong" .

caveat:AnomalousReviewTimeline
    caveat:evidenceFor caveat:CompromisedPeerReview ;
    caveat:evidenceStrength "moderate" .

caveat:AuthorClusterAnomaly
    caveat:evidenceFor caveat:PapermillOperation ;
    caveat:evidenceStrength "moderate" .

caveat:AuthorClusterAnomaly
    caveat:evidenceFor caveat:CitationManipulation ;
    caveat:evidenceStrength "moderate" .

caveat:CitationPatternAnomaly
    caveat:evidenceFor caveat:CitationManipulation ;
    caveat:evidenceStrength "definitive" .

caveat:RetractionNotice
    caveat:evidenceFor caveat:Fabrication ;
    caveat:evidenceStrength "definitive" .

caveat:RetractionNotice
    caveat:evidenceFor caveat:Falsification ;
    caveat:evidenceStrength "definitive" .

caveat:RetractionNotice
    caveat:evidenceFor caveat:TextPlagiarism ;
    caveat:evidenceStrength "definitive" .

caveat:ExpressionOfConcern
    caveat:evidenceFor caveat:Falsification ;
    caveat:evidenceStrength "moderate" .

# =============================================================================
# REPRODUCIBILITY MARKER LINKS
# =============================================================================

caveat:FailedIndependentReplication
    caveat:evidenceFor caveat:Fabrication ;
    caveat:evidenceStrength "moderate" .

caveat:FailedIndependentReplication
    caveat:evidenceFor caveat:PathologicalScience ;
    caveat:evidenceStrength "moderate" .

caveat:FailedIndependentReplication
    caveat:evidenceFor caveat:StatisticalMalpractice ;
    caveat:evidenceStrength "weak" .

caveat:NonResponsiveAuthors
    caveat:evidenceFor caveat:Fabrication ;
    caveat:evidenceStrength "weak" .

caveat:WithdrawnDataMethodology
    caveat:evidenceFor caveat:Falsification ;
    caveat:evidenceStrength "strong" .
