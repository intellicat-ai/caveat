@prefix caveat: <https://w3id.org/intellicat/caveat#> .
@prefix iao:    <http://purl.obolibrary.org/obo/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/intellicat/caveat/modules/marker-evidence> a owl:Ontology ;
    rdfs:comment "Evidence links between detection markers and unreliability modes, modelled as named nodes so that each link carries its own strength."@en .

caveat:evidenceFor a owl:ObjectProperty ;
    rdfs:label "evidence for"@en ;
    rdfs:comment "Shortcut: the marker is linked to the mode by a fixed-mode caveat:EvidenceLink. Always equal to the projection of those links."@en ;
    rdfs:domain caveat:DetectionMarker ;
    rdfs:range caveat:UnreliabilityMode .

caveat:EvidenceStrength a owl:Class ;
    rdfs:label "evidence strength"@en ;
    caveat:definition "A value partition expressing how strongly observing a detection marker supports an unreliability mode."@en .

caveat:DefinitiveEvidence a owl:NamedIndividual, caveat:EvidenceStrength ;
    rdfs:label "definitive"@en ;
    caveat:strengthRank "4"^^xsd:integer ;
    caveat:intensityLowerBound "0.75"^^xsd:decimal ;
    caveat:definition "An evidence strength at which the marker alone is sufficient to establish the mode."@en .

caveat:StrongEvidence a owl:NamedIndividual, caveat:EvidenceStrength ;
    rdfs:label "strong"@en ;
    caveat:strengthRank "3"^^xsd:integer ;
    caveat:intensityLowerBound "0.5"^^xsd:decimal ;
    caveat:definition "An evidence strength at which the marker has high positive predictive value for the mode."@en .

caveat:ModerateEvidence a owl:NamedIndividual, caveat:EvidenceStrength ;
    rdfs:label "moderate"@en ;
    caveat:strengthRank "2"^^xsd:integer ;
    caveat:intensityLowerBound "0.25"^^xsd:decimal ;
    caveat:definition "An evidence strength at which the marker suggests the mode but needs corroboration."@en .

caveat:WeakEvidence a owl:NamedIndividual, caveat:EvidenceStrength ;
    rdfs:label "weak"@en ;
    caveat:strengthRank "1"^^xsd:integer ;
    caveat:intensityLowerBound "0.0"^^xsd:decimal ;
    caveat:definition "An evidence strength at which the marker is a possible indicator with a high false positive rate."@en .

caveat:GradedEvidence a owl:NamedIndividual, caveat:EvidenceStrength ;
    rdfs:label "graded"@en ;
    caveat:definition "An evidence strength that is not fixed for the link but is derived from the intensity reported with each observation of the marker, using the intensity lower bounds of the ranked strengths."@en .

caveat:EvidenceLink a owl:Class ;
    rdfs:subClassOf iao:IAO_0000030 ;
    rdfs:label "evidence link"@en ;
    caveat:definition "An information content entity asserting that observing a given detection marker is evidence, of a stated strength, for an unreliability mode."@en .

caveat:StatedReasonEvidenceLink a owl:Class ;
    rdfs:subClassOf caveat:EvidenceLink ;
    rdfs:label "stated-reason evidence link"@en ;
    caveat:definition "An evidence link whose unreliability mode is not fixed but is the mode stated by the observed marker itself, such as the reason given in a retraction notice."@en .

caveat:linkMarker a owl:ObjectProperty ;
    rdfs:label "link marker"@en ;
    rdfs:domain caveat:EvidenceLink ;
    rdfs:range caveat:DetectionMarker .

caveat:linkMode a owl:ObjectProperty ;
    rdfs:label "link mode"@en ;
    rdfs:domain caveat:EvidenceLink ;
    rdfs:range caveat:UnreliabilityMode ;
    rdfs:comment "Absent on stated-reason evidence links."@en .

caveat:evidenceStrength a owl:ObjectProperty ;
    rdfs:label "evidence strength of link"@en ;
    rdfs:domain caveat:EvidenceLink ;
    rdfs:range caveat:EvidenceStrength ;
    rdfs:comment "Replaces the v0.2.0 annotation property of the same IRI, which took string literals on markers."@en .

caveat:strengthRank a owl:AnnotationProperty ;
    rdfs:label "strength rank"@en ;
    rdfs:range <http://www.w3.org/2001/XMLSchema#integer> .

caveat:intensityLowerBound a owl:AnnotationProperty ;
    rdfs:label "intensity lower bound"@en ;
    rdfs:range <http://www.w3.org/2001/XMLSchema#decimal> .

caveat:evidence_TorturedPhrases_PapermillOperation a owl:NamedIndividual, caveat:EvidenceLink ;
    caveat:linkMarker caveat:TorturedPhrases ;
    caveat:linkMode caveat:PapermillOperation ;
    caveat:evidenceStrength caveat:StrongEvidence .
caveat:TorturedPhrases caveat:evidenceFor caveat:PapermillOperation .

