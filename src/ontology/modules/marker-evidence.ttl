    caveat:linkMarker caveat:BoilerplateTemplateText ;
    caveat:linkMode caveat:PapermillOperation ;
    caveat:evidenceStrength caveat:ModerateEvidence .
caveat:BoilerplateTemplateText caveat:evidenceFor caveat:PapermillOperation .

caveat:evidence_BoilerplateTemplateText_DuplicatePublication a owl:NamedIndividual, caveat:EvidenceLink ;
    caveat:linkMarker caveat:BoilerplateTemplateText ;
    caveat:linkMode caveat:DuplicatePublication ;
