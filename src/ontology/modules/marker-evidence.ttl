    caveat:evidenceStrength caveat:StrongEvidence .
caveat:ClonedImages caveat:evidenceFor caveat:Falsification .

caveat:evidence_ClonedImages_PapermillOperation a owl:NamedIndividual, caveat:EvidenceLink ;
