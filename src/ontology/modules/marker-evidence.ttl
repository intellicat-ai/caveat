    caveat:evidenceStrength caveat:StrongEvidence .
caveat:ClonedImages caveat:evidenceFor caveat:PapermillOperation .

caveat:evidence_ImageManipulationArtifacts_Falsification a owl:NamedIndividual, caveat:EvidenceLink ;
    caveat:linkMarker caveat:ImageManipulationArtifacts ;
    caveat:linkMode caveat:Falsification ;
